<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4f46e5" />
      <stop offset="100%" stop-color="#06b6d4" />
    </linearGradient>
    <linearGradient id="iconGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e0e7ff" />
    </linearGradient>
  </defs>

  <!-- Background Rounded Squircle -->
  <rect x="32" y="32" width="448" height="448" rx="128" fill="url(#bgGrad)"/>

  <!-- Boomerang / Refresh Arrow Path -->
  <g transform="translate(256, 256) scale(1.15) translate(-256, -256)">
    <path d="M 330 190 A 110 110 0 1 0 350 280 L 300 270 A 65 65 0 1 1 290 205 L 260 235 L 365 255 L 375 145 Z" fill="url(#iconGrad)" />
